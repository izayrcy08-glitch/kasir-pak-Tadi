rules_version = '2';

// Wajib login — hanya request dengan Firebase Auth token valid yang boleh
// baca/tulis. Satu akun sharing (Email/Password), lihat halaman Login di
// src/features/auth/. File ini sama persis dipakai emulator lokal maupun
// project Firebase asli.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
