# Dimuat HANYA saat `npm run build` (mode production), dan menimpa .env.local.
#
# Kenapa file ini ada: .env.local dipakai untuk dev dan berisi
# VITE_USE_EMULATOR=true, tapi Vite ikut memuat .env.local saat build produksi.
# Tanpa file ini, build yang di-deploy akan menyambung ke emulator di
# localhost:8080 — aplikasi mati total di device toko.
#
# File ini sengaja DI-COMMIT (tidak berisi credential apa pun) supaya tidak ada
# build produksi di masa depan yang bisa lolos dengan emulator menyala.
VITE_USE_EMULATOR=false
